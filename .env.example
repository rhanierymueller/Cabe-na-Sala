# Google Analytics 4 — Measurement ID (Admin → Fluxos de dados → Web).
# Opcional: sobrescreve o ID padrão de produção definido em src/utils/analytics.ts.
# Em dev, deixar vazio mantém o GA desligado (não suja as métricas).
VITE_GA_ID=

# ---------- Foto -> modelo 3D (rota /api/modelo3d) ----------
# Sem FAL_KEY o recurso responde "indisponível" e o resto do site funciona normal.

# Chave da fal.ai (perfil "API"). Só no servidor. Use saldo pré-pago, sem recarga automática.
FAL_KEY=

# Limite de uso compartilhado (Vercel KV / Upstash Redis, API REST).
# OBRIGATÓRIO em qualquer deploy na Vercel: sem isso a rota se recusa a rodar.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Anti-robô (Cloudflare Turnstile). OBRIGATÓRIO em deploy, pelo mesmo motivo.
# A chave do site vai para o navegador; a secreta fica só no servidor.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Opcional: teto de gerações por dia (padrão 100).
MODELO3D_TETO_DIARIO=

# ---------- Claude (confere a foto e lê as medidas do anúncio em /api/medidas) ----------
# Chave da API da Anthropic. Só no servidor. Sem ela a foto não é conferida
# e a leitura do anúncio responde "indisponível"; o resto funciona normal.
# Mantenha a recarga automática desligada: o saldo é o teto de gasto.
ANTHROPIC_API_KEY=
# Opcional: modelo usado (padrão claude-haiku-5-5).
CLAUDE_MODELO=
# Opcional: modelo que acha a referência na foto da sala (padrão claude-sonnet-5-5).
CLAUDE_MODELO_REFERENCIA=
